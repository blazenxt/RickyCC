TOKEN=
OWNER_ID=
# Recommended — log chat ID. Also used for AUTOMATIC DB BACKUP & RESTORE:
# bot.db is uploaded+pinned here every 30 min, and auto-restored after a
# redeploy on ephemeral hosts (bot needs pin rights in this chat).
LOGGER_ID=
# Optional — these only SEED the settings on first boot.
# Afterwards everything is managed live via /admin → Settings:
FSUB_IDS=
# Example: FSUB_IDS=-1001234567890,-1009876543210
# Optional — PostgreSQL connection string (managed, persistent).
# On Railway: add the PostgreSQL plugin and link it — DATABASE_URL is
# injected automatically and ALL bot data (users, cards, settings) is
# stored there, surviving every redeploy. When unset, embedded SQLite is
# used instead (with Telegram-chat backups if LOGGER_ID is set).
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=
# Optional — local SQLite file location (default: bot.db)
DB_PATH=
# Optional webhook mode
SECRET_TOKEN=
WEBHOOK_URL=
PORT=
