TOKEN=
OWNER_ID=
# Recommended — log chat ID. Also used for AUTOMATIC DB BACKUP & RESTORE:
# bot.db is uploaded+pinned here every 30 min, and auto-restored after a
# redeploy on ephemeral hosts (bot needs pin rights in this chat).
LOGGER_ID=
# Optional — these only SEED the settings on first boot.
# Afterwards everything is managed live via /admin → Settings:
FSUB_IDS=
# Example: FSUB_IDS=-1001234567890,-1009876543210
# Optional — local SQLite file location (default: bot.db)
DB_PATH=
# Optional webhook mode
SECRET_TOKEN=
WEBHOOK_URL=
PORT=
